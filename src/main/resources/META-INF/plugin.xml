<idea-plugin>
    <id>dev.angelminga.react-props-doc</id>
    <name>React Props Doc</name>
    <vendor>Angel Minga</vendor>
    <description><![CDATA[
        Muestra las props de un componente React (desde <code>propTypes</code>, <code>defaultProps</code>
        y la desestructuración de props) en la documentación al pasar el mouse sobre un tag JSX,
        sin tener que agregar JSDoc. Para componentes de librerías con tipos (<code>.d.ts</code>, como
        @mui/material) muestra sus props propias con tipo, valor por defecto y descripción, y las heredadas.
        <ul>
          <li>Marca props usadas sin declarar en <code>propTypes</code> y declaradas que no se usan; Alt+Enter las
              agrega a <code>propTypes</code> (deduciendo el tipo) o genera el bloque completo.</li>
          <li>Hover sobre una prop: si es requerida, su valor por defecto y sus valores posibles.</li>
          <li>Hooks: parámetros y lo que devuelven, y aviso al desestructurar un valor que el hook no devuelve (Alt+Enter lo cambia por uno que sí devuelve).</li>
          <li>Traducciones (<code>getLanguagePage('página')</code>): autocompletado y Ctrl+clic de páginas, autocompletado
              de claves, textos por idioma al pasar el mouse, avisos de páginas/claves inexistentes o faltantes en algún
              idioma, y corrección rápida que las copia desde el idioma base marcadas con <code>[ES]</code> para traducirlas.</li>
          <li>Aviso de props que el componente no acepta (<code>&lt;Button text="…"&gt;</code>) con correcciones.</li>
          <li>Extraer texto fijo del JSX a las traducciones (Alt+Enter).</li>
          <li>Redux: autocompletado, hover (estado inicial y acciones) y Ctrl+clic en <code>useSelector(state =&gt; state.x)</code>.</li>
          <li>Ajustes en Settings → Tools → React Props Doc.</li>
        </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>JavaScript</depends>
    <depends>com.intellij.modules.json</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- API nueva de documentación: se consulta antes que los lang.documentationProvider (incluido el de React) -->
        <platform.backend.documentation.psiTargetProvider
                order="first"
                implementation="dev.angelminga.reactpropsdoc.ReactPropsDocumentationTargetProvider"/>
        <!-- Redux: useSelector(state => state.x) -->
        <completion.contributor language="JavaScript"
                                implementationClass="dev.angelminga.reactpropsdoc.ReduxCompletionContributor"/>
        <platform.backend.documentation.targetProvider
                implementation="dev.angelminga.reactpropsdoc.ReduxDocumentationTargetProvider"/>
        <!-- Hover en accesos a traducciones (buttons.cancel): antes que la resolución ambigua del IDE -->
        <platform.backend.documentation.targetProvider order="first"
                implementation="dev.angelminga.reactpropsdoc.TranslationAccessDocumentationTargetProvider"/>
        <!-- Ctrl+clic: state.x → reducer / clave de traducción → JSON -->
        <gotoDeclarationHandler order="first" implementation="dev.angelminga.reactpropsdoc.ReactPropsGotoDeclarationHandler"/>

        <!-- Traducciones: Ctrl+clic / autocompletado de páginas y claves de getLanguagePage('…') -->
        <psi.referenceContributor language="JavaScript"
                                  implementation="dev.angelminga.reactpropsdoc.TranslationReferenceContributor"/>
        <completion.contributor language="JavaScript"
                                implementationClass="dev.angelminga.reactpropsdoc.TranslationKeyCompletionContributor"/>

        <localInspection language="JavaScript" shortName="ReactPropsDocHookDestructuring"
                         displayName="Valor desestructurado que el hook no devuelve"
                         groupName="React Props Doc" enabledByDefault="true" level="WARNING"
                         implementationClass="dev.angelminga.reactpropsdoc.HookDestructuringInspection"/>
        <localInspection language="JavaScript" shortName="ReactPropsDocTranslationKey"
                         displayName="Página o clave de traducción inexistente o incompleta"
                         groupName="React Props Doc" enabledByDefault="true" level="WARNING"
                         implementationClass="dev.angelminga.reactpropsdoc.TranslationKeyInspection"/>
        <localInspection language="JSON" shortName="ReactPropsDocTranslationFile"
                         displayName="Archivo de traducción con páginas o claves faltantes"
                         groupName="React Props Doc" enabledByDefault="true" level="WARNING"
                         implementationClass="dev.angelminga.reactpropsdoc.TranslationFileInspection"/>

        <localInspection language="JavaScript" shortName="ReactPropsDocUndeclaredProp"
                         displayName="Prop usada sin declarar en propTypes"
                         groupName="React Props Doc" enabledByDefault="true" level="WEAK WARNING"
                         implementationClass="dev.angelminga.reactpropsdoc.UndeclaredPropInspection"/>
        <localInspection language="JavaScript" shortName="ReactPropsDocUnknownProp"
                         displayName="Prop que el componente no acepta"
                         groupName="React Props Doc" enabledByDefault="true" level="WARNING"
                         implementationClass="dev.angelminga.reactpropsdoc.UnknownPropInspection"/>
        <localInspection language="JavaScript" shortName="ReactPropsDocHardcodedText"
                         displayName="Texto fijo en JSX sin traducir"
                         groupName="React Props Doc" enabledByDefault="false" level="WEAK WARNING"
                         implementationClass="dev.angelminga.reactpropsdoc.HardcodedTextInspection"/>
        <intentionAction>
            <language>JavaScript</language>
            <className>dev.angelminga.reactpropsdoc.ExtractTextToTranslationIntention</className>
            <category>React Props Doc</category>
        </intentionAction>
        <intentionAction>
            <language>JavaScript</language>
            <className>dev.angelminga.reactpropsdoc.GeneratePropTypesIntention</className>
            <category>React Props Doc</category>
        </intentionAction>

        <applicationConfigurable parentId="tools"
                                 id="dev.angelminga.reactpropsdoc.settings"
                                 displayName="React Props Doc"
                                 instance="dev.angelminga.reactpropsdoc.ReactPropsDocConfigurable"/>
    </extensions>
</idea-plugin>
